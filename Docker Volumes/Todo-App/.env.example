# Example environment variables for backend
# Copy this to .env in the root directory and adjust as needed

# Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_NAME=tododb
DB_USER=todouser
DB_PASSWORD=todopass

# Server Configuration
NODE_ENV=development
PORT=5000

# For production, change these values
# DB_HOST=your-rds-endpoint
# DB_NAME=production_db
# NODE_ENV=production
